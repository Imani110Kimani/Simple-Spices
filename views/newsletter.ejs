<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Newsletter Signup - Aroha Spices and Condiment</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Aroha Spices and Condiment</h1>
    <nav>\n      <a href="/">Home</a>\n      <a href="/#spices">Spices</a>\n      <a href="/#about">About</a>\n      <a href="/#contact">Contact</a>\n      <a href="/#newsletter">Newsletter</a>\n      <a href="/#testimonials">Testimonials</a>\n      <a href="/#blog">Blog</a>\n    </nav>
  </header>
  <main>
    <section class="newsletter-section" style="max-width: 500px; margin: 2rem auto; background: #2f1b13; border-radius: 18px; box-shadow: 0 2px 12px rgba(191, 167, 106, 0.08); padding: 2rem;">
      <h2 style="color:#997950; text-align:center;">Sign Up for Our Newsletter</h2>
      <form method="POST" action="/newsletter" style="display:flex; flex-direction:column; gap:1.2rem;">
        <input type="email" name="email" placeholder="Your Email" required style="padding:0.7rem; border-radius:8px; border:1px solid #997950; background:#2f1b13; color:#fff;">
        <button type="submit" class="button" style="width:100%;">Subscribe</button>
      </form>
      <% if (success) { %>
        <p style="color:#997950; text-align:center; margin-top:1rem;">Thank you for subscribing!</p>
      <% } %>
    </section>
  </main>
  <footer>
    <p>&copy; 2026 Aroha Spices and Condiment. All rights reserved.</p>
  </footer>
</body>
</html>


